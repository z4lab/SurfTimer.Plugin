<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Copy all NuGet runtime dependencies to $(OutDir) on Build -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>DEBUG</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CounterStrikeSharp.API" Version="1.0.374" />
		<PackageReference Include="MaxMind.GeoIP2" Version="6.0.0" />
		<PackageReference Include="MySqlConnector" Version="2.6.1" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<!-- Add Dapper, to ensure Dapper.dll is included in the output -->
		<PackageReference Include="Dapper" Version="2.1.79" />
	</ItemGroup>

	<!-- Public API for addons - deployed to shared/SurfTimer.Api/ (build.ps1), never next to the plugin: a copy here
	     would give addons other types -->
	<ItemGroup>
		<ProjectReference Include="..\api\SurfTimer.Api.csproj" />
	</ItemGroup>

	<!-- Database migrations, applied by MigrationRunner on plugin load -->
	<ItemGroup>
		<EmbeddedResource Include="ST-Data\Migrations\*.sql" LogicalName="Migrations.%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Build info for !admin (BuildInfo.cs): the commit is already in the informational version (SourceLink,
	     "1.0.0+<sha>"), this adds the build time and whether there were uncommitted changes -->
	<Target Name="AddBuildInfo" BeforeTargets="GetAssemblyAttributes">
		<Exec Command="git status --porcelain --untracked-files=no" WorkingDirectory="$(MSBuildProjectDirectory)"
			ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" ContinueOnError="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="_StGitStatus" />
			<Output TaskParameter="ExitCode" PropertyName="_StGitExitCode" />
		</Exec>
		<ItemGroup>
			<AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::UtcNow.ToString('yyyy-MM-dd HH:mm'))" />
			<AssemblyMetadata Include="GitDirty" Value="true" Condition="'$(_StGitExitCode)' == '0' And '$(_StGitStatus)' != ''" />
		</ItemGroup>
	</Target>

	<!-- After Build, keep only the necessary files -->
	<Target Name="KeepOnlySelectedDlls" AfterTargets="Build">
		<ItemGroup>
			<Keep
				Include="$(OutDir)SurfTimer.Plugin.dll;
					  $(OutDir)SurfTimer.Plugin.pdb;
					  $(OutDir)Dapper.dll;
					  $(OutDir)MaxMind.Db.dll;
					  $(OutDir)MaxMind.GeoIP2.dll;
					  $(OutDir)MySqlConnector.dll" />
			<AllDlls Include="$(OutDir)*.dll" />
			<ToDelete Include="@(AllDlls)" Exclude="@(Keep)" />
		</ItemGroup>

		<Delete Files="@(ToDelete)" />
	</Target>

	<!-- Same for publish (build.ps1 stages the publish output) -->
	<Target Name="KeepOnlySelectedPublishedDlls" AfterTargets="Publish">
		<ItemGroup>
			<PublishKeep
				Include="$(PublishDir)SurfTimer.Plugin.dll;
					  $(PublishDir)SurfTimer.Plugin.pdb;
					  $(PublishDir)Dapper.dll;
					  $(PublishDir)MaxMind.Db.dll;
					  $(PublishDir)MaxMind.GeoIP2.dll;
					  $(PublishDir)MySqlConnector.dll" />
			<PublishAll Include="$(PublishDir)*.dll;$(PublishDir)*.pdb" />
			<PublishDelete Include="@(PublishAll)" Exclude="@(PublishKeep)" />
		</ItemGroup>

		<Delete Files="@(PublishDelete)" />
	</Target>
</Project>
